# Financial Modeling Prep API key - used for financial data fetching (Tier 2)
FMP_API_KEY=your_fmp_api_key_here

# Alpha Vantage API key - used for stock market data (Tier 2)
ALPHAVANTAGE_API_KEY=your_alphavantage_api_key_here

# Polygon.io API key - used for market data and alternative data feeds (Tier 2)
POLYGON_API_KEY=your_polygon_api_key_here

# SEC EDGAR User-Agent - required user-agent string for SEC EDGAR API access (Tier 1)
SEC_EDGAR_USER_AGENT=your_email_or_app_identifier_here
